# Telegram Bot Configuration
# Dapatkan token dari @BotFather di Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Optional: Batasi akses hanya untuk user ID tertentu
# Pisahkan dengan koma jika lebih dari satu
# Contoh: ALLOWED_USER_IDS=123456789,987654321
# Kosongkan untuk mengizinkan semua user
ALLOWED_USER_IDS=
